{
  "name": "@iola_adm/yoshkar-ola-public-mcp",
  "version": "0.1.8",
  "description": "STDIO launcher for the Yoshkar-Ola Public MCP remote server.",
  "license": "MIT",
  "homepage": "https://github.com/adm-iola/yoshkar-ola-public-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adm-iola/yoshkar-ola-public-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/adm-iola/yoshkar-ola-public-mcp/issues"
  },
  "bin": {
    "yoshkar-ola-public-mcp": "npm/bin/yoshkar-ola-public-mcp.js"
  },
  "files": [
    "npm/bin",
    "npm/scripts",
    "npm/test",
    "layers",
    "schemas",
    "skills/yoshkar-ola-open-data",
    "docs/assets/icons",
    "docs/assets/readme-header.png",
    "docs/openapi",
    "docs/examples",
    "docs/release.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node npm/bin/yoshkar-ola-public-mcp.js",
    "release-check": "node npm/scripts/release-check.js",
    "test": "node --check npm/bin/yoshkar-ola-public-mcp.js && node --test npm/test/*.test.js && npm run release-check"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "open-data",
    "yoshkar-ola"
  ],
  "dependencies": {
    "mcp-remote": "^0.1.38"
  },
  "engines": {
    "node": ">=22.5.0"
  }
